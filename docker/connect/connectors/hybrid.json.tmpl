{
  "name": "__NAME__",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",

    "database.hostname": "oracle",
    "database.port": "1521",
    "database.user": "c##dbzuser",
    "database.password": "Dbz_Th3sis_2026",
    "database.dbname": "FREE",
    "database.pdb.name": "OBSVPDB",

    "topic.prefix": "__PREFIX__",
    "schema.history.internal.kafka.bootstrap.servers": "kafka-1:9092,kafka-2:9092,kafka-3:9092",
    "schema.history.internal.kafka.topic": "_schema_history.__PREFIX__",

    "table.include.list": "OBSV.A1_EVENT_OUTBOX",

    "snapshot.mode": "no_data",
    "snapshot.locking.mode": "none",
    "log.mining.strategy": "online_catalog",
    "log.mining.transaction.retention.ms": "180000",

    "heartbeat.interval.ms": "1000",
    "heartbeat.action.query": "UPDATE OBSV.DBZ_HEARTBEAT SET TS = SYSTIMESTAMP WHERE ID = 1",

    "lob.enabled": "true",
    "decimal.handling.mode": "string",
    "tombstones.on.delete": "false",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.storage.StringConverter",

    "predicates": "isOutbox",
    "predicates.isOutbox.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.isOutbox.pattern": "__PREFIX__\\.OBSV\\.A1_EVENT_OUTBOX",

    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.predicate": "isOutbox",
    "transforms.outbox.table.field.event.id": "EVENT_ID",
    "transforms.outbox.table.field.event.key": "AGGREGATE_ID",
    "transforms.outbox.table.field.event.type": "EVENT_TYPE",
    "transforms.outbox.table.field.event.payload": "PAYLOAD",
    "_comment.timestamp": "table.field.event.timestamp is deliberately NOT set. It makes EventRouter stamp the Kafka record with the outbox row's CREATED_AT, i.e. the moment the row was inserted inside the business transaction. End-to-end latency is then measured as arrival-minus-commit where arrival is really the insert, which produced a median of -1 ms: physically impossible, and it would have reported the hybrid as the fastest pipeline ever measured. Left unset, the record carries its produce time, which is what every other mode is measured with.",
    "transforms.outbox.table.expand.json.payload": "false",
    "transforms.outbox.table.fields.additional.placement": "EVENT_SEQ:header:eventSeq,SCHEMA_VERSION:header:schemaVersion,SOURCE_SYSTEM:header:sourceSystem",
    "transforms.outbox.route.by.field": "AGGREGATE_TYPE",
    "_comment.route": "Routed by aggregate type rather than to one fixed topic. AGGREGATE_TYPE is a1.transaction or credit.application, so this yields bank.a1.transaction.events and bank.credit.application.events - the A1 topic name is unchanged, so the completed experiments are unaffected, while credit events get their own topic instead of being counted as phantoms by the A1 reconciliation.",
    "transforms.outbox.route.topic.replacement": "bank.${routedByValue}.events"
  }
}
